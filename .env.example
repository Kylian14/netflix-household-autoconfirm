# Required
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Optional (defaults shown)
# IMAP_PORT=993
# IMAP_FOLDER=INBOX
# Gmail: INBOX already includes the Promotions/Updates tabs. Only for archived or
# filtered mail, use the (localized) all-mail folder, e.g.
# IMAP_FOLDER=[Gmail]/All Mail   (French: [Gmail]/Tous les messages)
